# =========================================================
#  Unreal Engine 5 C++ Project .gitignore (TheLastCheckIn)
#  Assets (Content/) are tracked with Git LFS — see .gitattributes
# =========================================================

# ---------- UE generated / cache folders ----------
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Plugins/**/Binaries/
Plugins/**/Intermediate/
Plugins/**/Saved/
Plugins/**/DerivedDataCache/
Platforms/**/Binaries/
Platforms/**/Intermediate/

# Builds (keep PakBlacklist and icons)
Build/*
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# Built data for maps (static lighting; regenerate with Build Lighting)
*_BuiltData.uasset

# ---------- IDE / project files (regenerated by "Generate Project Files") ----------
.vs/
.vscode/
.idea/
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.code-workspace
*.xcodeproj
*.xcworkspace
*.DotSettings.user
.vsconfig

# ---------- Compiled output ----------
*.slo
*.lo
*.o
*.gch
*.pch
*.ipch
*.pdb
*.so
*.dylib
*.dll
*.mod
*.lai
*.la
*.a
*.lib
*.exe
*.out
*.app
*.ipa

# ---------- Source art (keep raw art outside the repo) ----------
SourceArt/**/*.png
SourceArt/**/*.tga

# ---------- OS / misc ----------
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.bak
*.log

# ---------- Tool-local config ----------
.claude/settings.local.json
