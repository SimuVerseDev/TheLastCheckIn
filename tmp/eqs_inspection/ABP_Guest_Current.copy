         ShowPinForProperties(4)=(PropertyName="bTransferPoseInGlobalSpace",PropertyFriendlyName="Transfer Pose in Global Space",PropertyTooltip=NSLOCTEXT("UObjectToolTips", "AnimNode_ControlRigBase:bTransferPoseInGlobalSpace", "Transferring the pose in global space guarantees a global pose match,\nwhile transferring in local space ensures a match of the local transforms.\nIn general transforms only differ if the hierarchy topology differs\nbetween the Control Rig and the skeleton used in the AnimBP.\nNote: Turning this off can potentially improve performance."),CategoryName="Settings",bIsMarkedForAdvancedDisplay=True)
