(fn BeginCarry (NewCarrier)
  (bind _pickupbody (Variables|Default|GetPickupBody))
  (Variables|Default|SetCarrier NewCarrier)
  (Variables|Default|SetIsStored false)
  (Transformation|DetachFromActor "KeepWorld" "KeepWorld")
  (Collision|SetCollisionProfileName _pickupbody "PhysicsActor")
  (Collision|SetCollisionResponseToChannel _pickupbody "ECC_Pawn")
  (Physics|SetSimulatePhysics _pickupbody true)
  (if (Variables|Default|GetIsCart)
    (Collision|SetCollisionResponseToChannel _pickupbody "ECC_Visibility" "ECR_Overlap")
    (else
      (Collision|SetCollisionResponseToChannel _pickupbody "ECC_Visibility" "ECR_Block")
      (CallFunction|EnableReturnPoint)
      (CallFunction|FilterHomeCartCollision))))
