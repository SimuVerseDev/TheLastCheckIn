(fn SpawnCartItems ()
  (bind _self self)
  (bind _itempoint_1 (|GetItemPoint_1))
  (bind _itempoint_2 (|GetItemPoint_2))
  (bind _itempoint_3 (|GetItemPoint_3))
  (bind _returnvalue (Game|SpawnActorBPCartMop "/Game/CleaningCart/Blueprints/BP_CartMop.BP_CartMop_C" (Transformation|GetWorldTransform _itempoint_1) "AlwaysSpawn" "MultiplyWithRoot" _self 0))
  (CallFunction|InitializeCartSlot _returnvalue _self _itempoint_1 (|GetReturnZone_1))
  (bind _returnvalue_1 (Game|SpawnActorBPCartCloth "/Game/CleaningCart/Blueprints/BP_CartCloth.BP_CartCloth_C" (Transformation|GetWorldTransform _itempoint_2) "AlwaysSpawn" "MultiplyWithRoot" _self 0))
  (CallFunction|InitializeCartSlot _returnvalue_1 _self _itempoint_2 (|GetReturnZone_2))
  (bind _returnvalue_2 (Game|SpawnActorBPCartTrashBin "/Game/CleaningCart/Blueprints/BP_CartTrashBin.BP_CartTrashBin_C" (Transformation|GetWorldTransform _itempoint_3) "AlwaysSpawn" "MultiplyWithRoot" _self 0))
  (CallFunction|InitializeCartSlot _returnvalue_2 _self _itempoint_3 (|GetReturnZone_3)))
