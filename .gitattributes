# =========================================================
#  Git attributes for Unreal Engine 5 (TheLastCheckIn)
#  Hybrid VCS: assets (Content/) live in Perforce, not Git/LFS.
# =========================================================

# Normalize line endings for text files
* text=auto

# Source / config as text
*.cpp     text diff=cpp
*.h       text diff=cpp
*.hpp     text diff=cpp
*.inl     text diff=cpp
*.cs      text diff=csharp
*.ini     text
*.uproject text
*.uplugin  text
*.json    text
*.md      text
*.usf     text
*.ush     text
*.bat     text eol=crlf
*.sh      text eol=lf

# Binary files that may live outside Content/ (not diffed or normalized)
*.png     binary
*.jpg     binary
*.ico     binary

# ---------- Third-party prebuilt libs (only if committed under Source/ThirdParty) ----------
Source/ThirdParty/**/*.dll filter=lfs diff=lfs merge=lfs -text
Source/ThirdParty/**/*.lib filter=lfs diff=lfs merge=lfs -text
Source/ThirdParty/**/*.a   filter=lfs diff=lfs merge=lfs -text
Source/ThirdParty/**/*.so  filter=lfs diff=lfs merge=lfs -text
